{
  "comments": {
    "lineComment": "#",
    "blockComment": ["#[[", "]]"]
  },
  "brackets": [
    ["(", ")"],
    ["{", "}"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["{", "}"],
    ["[", "]"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(if|elseif|else|foreach|while|function|macro|block)\\s*\\(.*$",
    "decreaseIndentPattern": "^\\s*(elseif|else|endif|endforeach|endwhile|endfunction|endmacro|endblock)\\s*\\("
  },
  "folding": {
    "markers": {
      "start": "^\\s*#\\s*region\\b",
      "end": "^\\s*#\\s*endregion\\b"
    }
  },
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*"
}
